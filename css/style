
/* PRODUCT / PLACE / PAGE / AUTH STYLES */
.product-card{background:var(--white);border:1px solid var(--border);border-radius:18px;overflow:hidden;transition:.3s;box-shadow:0 5px 18px rgba(20,25,50,.03)}
.product-card:hover{transform:translateY(-6px);box-shadow:var(--shadow)}
.product-image{height:225px;position:relative;background:#111;overflow:hidden}
.product-image img{width:100%;height:100%;object-fit:cover;display:block;transition:.5s}
.product-card:hover .product-image img{transform:scale(1.05)}
.image-tag{position:absolute;left:14px;top:14px;background:rgba(0,0,0,.65);color:#fff;padding:6px 9px;border-radius:7px;font-size:10px;font-weight:800;letter-spacing:.5px}
.product-body{padding:20px}.card-top{display:flex;justify-content:space-between;align-items:center}
.heart{border:1px solid var(--border);background:var(--white);color:var(--muted);width:34px;height:34px;border-radius:50%;font-size:20px}
.heart.saved{color:#e84a6a;border-color:#e84a6a;background:rgba(232,74,106,.08)}
.product-body h3{font-family:Poppins,sans-serif;font-size:21px;margin:9px 0 6px}.product-body p{font-size:13px;color:var(--muted);min-height:60px}
.spec-list{display:flex;flex-wrap:wrap;gap:6px;margin:14px 0}.spec-list span{font-size:10px;padding:5px 7px;background:rgba(108,92,231,.08);color:var(--primary);border-radius:5px}
.details-btn{border:0;background:none;color:var(--primary);font-weight:800;padding:0}
.place-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.place-card{background:var(--white);border:1px solid var(--border);border-radius:18px;overflow:hidden}.place-card>img{width:100%;height:230px;object-fit:cover}.place-content{padding:22px}.place-content h3{font:700 25px Poppins;margin:5px 0}.place-content p{color:var(--muted);font-size:13px}.place-content h4{margin-top:16px}.place-content ul{padding-left:18px;color:var(--muted);font-size:13px}.place-content li{margin:5px 0}
.page-hero{padding:100px 0 75px;background:radial-gradient(circle at 80% 20%,rgba(108,92,231,.16),transparent 35%)}.page-hero h1{font:800 clamp(38px,6vw,64px) Poppins;max-width:800px;line-height:1.1;margin:10px 0 15px}.page-hero p{color:var(--muted);max-width:700px}
.two-col,.about-layout,.contact-layout{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:start}.two-col h2,.about-layout h2,.contact-layout h2{font:700 36px Poppins;line-height:1.2}.two-col>p,.about-layout p,.contact-layout p{color:var(--muted);font-size:16px}.about-layout p{margin:18px 0}.about-box{padding:30px;border:1px solid var(--border);border-radius:18px;background:var(--white)}.about-box li{margin:12px 0;color:var(--muted)}
.feature-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.feature-strip>div{padding:28px;background:var(--white);border:1px solid var(--border);border-radius:15px}.feature-icon{font-size:25px}.feature-strip h3{margin:10px 0 4px}.feature-strip p{color:var(--muted);font-size:13px}
.contact-info{margin-top:30px;display:grid;gap:15px}.contact-info div{display:flex;flex-direction:column}.contact-info span{color:var(--muted);font-size:13px}.contact-form,.auth-card{background:var(--white);border:1px solid var(--border);border-radius:18px;padding:30px;box-shadow:var(--shadow)}label{display:flex;flex-direction:column;gap:7px;font-weight:600;font-size:13px;margin-bottom:16px}input,textarea{border:1px solid var(--border);background:transparent;color:var(--text);border-radius:9px;padding:12px;outline:none}input:focus,textarea:focus{border-color:var(--primary)}.error{color:#e04c5a;font-size:11px;min-height:13px}.success{color:#13a46d;font-size:12px;margin-top:10px}.check{flex-direction:row;align-items:center;font-weight:400}.check input{width:auto}.full{width:100%}
.auth-page{min-height:100vh;display:grid;place-items:center;background:radial-gradient(circle at 20% 20%,rgba(108,92,231,.15),transparent 35%),var(--light)}.auth-shell{width:min(480px,92%)}.auth-brand{justify-content:center;margin-bottom:25px}.auth-heading{text-align:center;margin-bottom:25px}.auth-heading h1{font:700 30px Poppins;margin:7px 0}.auth-heading p,.auth-switch,.demo-note{color:var(--muted);font-size:12px}.auth-switch{text-align:center;margin-top:18px}.auth-switch a{color:var(--primary);font-weight:700}.demo-note{text-align:center;margin-top:18px;font-size:10px}
.detail-modal{position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:3000;display:grid;place-items:center;padding:20px}.detail-panel{width:min(850px,100%);max-height:90vh;overflow:auto;background:var(--white);border-radius:20px;position:relative}.detail-panel>img{width:100%;height:300px;object-fit:cover}.detail-copy{padding:30px}.detail-copy h2{font:700 35px Poppins;margin:8px 0}.detail-copy p,.detail-copy li{color:var(--muted)}.detail-copy ul{padding-left:20px;margin:15px 0 25px}.close-detail{position:absolute;right:15px;top:15px;width:38px;height:38px;border:0;border-radius:50%;background:rgba(0,0,0,.6);color:#fff;font-size:25px;z-index:2}.empty-state{text-align:center;padding:50px;border:1px dashed var(--border);border-radius:18px;color:var(--muted)}.empty-state div{font-size:40px}.wishlist-grid:empty{display:none}
@media(max-width:900px){.category-grid{grid-template-columns:repeat(3,1fr)}.place-grid{grid-template-columns:1fr 1fr}.feature-strip{grid-template-columns:1fr 1fr}.two-col,.about-layout,.contact-layout{grid-template-columns:1fr}.hero-content{grid-template-columns:1fr}}
@media(max-width:650px){nav{display:none!important;position:absolute;top:70px;left:4%;width:92%;background:var(--white);padding:18px;border:1px solid var(--border);border-radius:12px;flex-direction:column}nav.open{display:flex!important}.menu-toggle{display:block}.category-grid,.place-grid,.feature-strip{grid-template-columns:1fr}.newsletter-box{grid-template-columns:1fr}.hero-card{display:none}.hero h1{font-size:42px}.two-col h2,.about-layout h2,.contact-layout h2{font-size:29px}}
